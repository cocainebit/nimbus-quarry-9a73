---
// The upstream component embedded a Vimeo player and loaded Vimeo's API script.
// Plotform templates do not load third-party players, so this renders a static
// panel instead. Point it at your own hosted file, or add a player you control.
export interface Props {
  videoid?: string;
  title?: string;
  class?: string;
}

const { title = "Video", class: className = "" } = Astro.props;
---

<div class={`plotform-video-placeholder ${className}`.trim()} role="group" aria-label={title}>
  <p>No video player is connected.</p>
  <p>Add a locally hosted file, or a player you control, before publishing.</p>
</div>

<style>
  .plotform-video-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    min-height: 12rem;
    padding: 1.5rem;
    text-align: center;
    background: #1d1e21;
    color: #d9d7d2;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .plotform-video-placeholder p {
    margin: 0;
  }
  .plotform-video-placeholder p + p {
    opacity: 0.72;
    font-size: 0.8125rem;
  }
</style>
