# Optional local AI generation. Demo mode works without any provider.
# Run a model separately using Ollama, then set its exact installed name.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
PORT=3001

# Select exactly one provider. No automatic paid-provider fallback.
MODEL_PROVIDER=ollama
# Venice AI: use the exact model ID from your account's model catalog.
VENICE_API_KEY=
VENICE_MODEL=
# Chutes provides inference on Bittensor Subnet 64.
CHUTES_API_KEY=
CHUTES_MODEL=

# Backend: run npm run setup:local to generate secure local values.
# For production set your actual PostgreSQL connection and HTTPS app origin.
DATABASE_URL=
AUTH_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Plotform <studio@localhost.test>
