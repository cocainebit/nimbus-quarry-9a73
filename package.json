{
  "name": "plotform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch --env-file-if-exists=.env server/index.mjs\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests vite.config.ts playwright.config.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "services:up": "docker compose up -d db mail",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:backend": "node --env-file=.env --test tests/*.integration.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "latest",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@puckeditor/core": "latest",
    "@xyflow/react": "latest",
    "better-auth": "^1.7.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.2",
    "helmet": "^8.3.0",
    "lucide-react": "latest",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
